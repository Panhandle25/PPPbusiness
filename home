<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panhandle Plumbing and Pools</title>
    <link rel="stylesheet" href="styles.css">
</head>

<body>
    <header>
        <div class="logo">
            <h1>Panhandle Plumbing and Pools</h1>
        </div>
        <nav>
            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#quote">Quote</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Home Section -->
    <section id="home" class="home">
        <div class="home-content">
            <h2>Welcome to Panhandle Plumbing and Pools!</h2>
            <p>Your go-to solution for all plumbing and pool maintenance needs in the Panhandle area.</p>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="about-content">
            <h2>About Us</h2>
            <p>We are a trusted plumbing and pool service company providing reliable solutions for homes and businesses. Our team of experienced professionals ensures your plumbing and pool needs are met with the highest quality service and care.</p>
        </div>
    </section>

    <!-- Quote Section -->
    <section id="quote" class="quote">
        <div class="quote-content">
            <h2>Get Your Free Quote</h2>
            <p>Fill out the form below to get an estimate for your plumbing or pool service needs.</p>
            <form action="#" method="POST">
                <label for="name">Your Name</label>
                <input type="text" id="name" name="name" required>

                <label for="email">Your Email</label>
                <input type="email" id="email" name="email" required>

                <label for="service">Service Needed</label>
                <select id="service" name="service">
                    <option value="plumbing">Plumbing</option>
                    <option value="pool-maintenance">Pool Maintenance</option>
                    <option value="both">Both</option>
                </select>

                <button type="submit">Get Quote</button>
            </form>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
        <div class="contact-content">
            <h2>Contact Us</h2>
            <p>Have questions? Reach out to us and we'll get back to you shortly!</p>
            <form action="#" method="POST">
                <label for="name-contact">Your Name</label>
                <input type="text" id="name-contact" name="name" required>

                <label for="email-contact">Your Email</label>
                <input type="email" id="email-contact" name="email" required>

                <label for="message">Your Message</label>
                <textarea id="message" name="message" rows="4" required></textarea>

                <button type="submit">Send Message</button>
            </form>
        </div>
    </section>

    <footer>
        <p>&copy; 2025 Panhandle Plumbing and Pools | All Rights Reserved</p>
    </footer>
</body>

</html>
