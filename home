/* General Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background-color: #fff;
    color: #333;
}

a {
    text-decoration: none;
    color: inherit;
}

header {
    background-color: #007BFF;
    padding: 20px;
    color: #fff;
    text-align: center;
}

header .logo h1 {
    font-size: 2.5em;
}

nav ul {
    list-style-type: none;
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 10px;
}

nav ul li a {
    color: #fff;
    font-size: 1.2em;
}

section {
    padding: 40px 20px;
    text-align: center;
}

section h2 {
    font-size: 2em;
    margin-bottom: 20px;
}

section p {
    font-size: 1.1em;
    margin-bottom: 20px;
}

form {
    display: flex;
    flex-direction: column;
    max-width: 600px;
    margin: 0 auto;
}

form label {
    margin-bottom: 8px;
    font-weight: bold;
    text-align: left;
}

form input, form select, form textarea {
    padding: 10px;
    margin-bottom: 20px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

form button {
    padding: 12px;
    background-color: #007BFF;
    color: #fff;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

form button:hover {
    background-color: #0056b3;
}

footer {
    background-color: #007BFF;
    padding: 20px;
    text-align: center;
    color: #fff;
}

/* Specific Section Styling */
.home {
    background-color: #e0f7ff;
}

.about, .quote, .contact {
    background-color: #f9f9f9;
    margin-bottom: 20px;
}

/* Mobile Specific Styles */
@media (max-width: 768px) {

    header .logo h1 {
        font-size: 2em;
    }

    nav ul {
        flex-direction: column;
        gap: 10px;
        margin-top: 10px;
    }

    nav ul li a {
        font-size: 1.2em;
    }

    section {
        padding: 30px 15px;
    }

    section h2 {
        font-size: 1.8em;
    }

    form {
        max-width: 90%;
    }

    form label {
        font-size: 1em;
    }

    form input, form select, form textarea {
        font-size: 1em;
    }

    footer p {
        font-size: 1em;
    }
}

/* Extra Small Devices (Phones in Portrait Mode) */
@media (max-width: 480px) {

    header .logo h1 {
        font-size: 1.8em;
    }

    nav ul {
        padding: 0;
    }

    nav ul li a {
        font-size: 1em;
    }

    section {
        padding: 20px 10px;
    }

    section h2 {
        font-size: 1.6em;
    }

    section p {
        font-size: 1em;
    }

    form label {
        font-size: 0.9em;
    }

    form input, form select, form textarea {
        font-size: 0.9em;
    }

    form button {
        padding: 10px;
        font-size: 1em;
    }

    footer p {
        font-size: 0.9em;
    }
}
